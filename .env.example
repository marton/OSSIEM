# Variables docker-compose.yml reads. In Coolify, set these under the
# resource's Environment Variables; locally, copy to .env.
# Everything without a default is required: compose refuses to start without it.
#
# Password character rules, because several of these end up in URLs or
# have to pass Wazuh's password policy:
#   INDEXER_PASSWORD      letters, digits, . _ - only (it goes into Graylog's
#                         indexer URL)
#   WAZUH_API_PASSWORD    8-64 chars with upper, lower, digit and one of . * + ? -
#   MYSQL_*_PASSWORD      letters and digits only (CoPilot builds a DSN from them)
#   others                anything, but letters/digits avoid quoting trouble
#
# Generate values, e.g.:
#   openssl rand -hex 24                               # passwords, tokens
#   openssl rand -base64 32                            # JWT_SECRET, SSO_STATE_SECRET
#   openssl rand -base64 32 | tr '+/' '-_'             # Fernet keys (TOTP_/WAF_TOKEN_ENCRYPTION_KEY)
#   echo "Aa1-$(openssl rand -hex 16)"                  # WAZUH_API_PASSWORD

#########
# Host  #
#########
# LAN IP or DNS name of the Coolify VM, as agents/endpoints and browsers reach it.
# Baked into Velociraptor client configs and CoPilot's TLS cert on first start.
STACK_HOST=192.168.1.50

#########
# Wazuh #
#########
# Applied on first deploy only; changing later needs securityadmin (DEPLOY.md)
INDEXER_PASSWORD=
DASHBOARD_PASSWORD=
WAZUH_API_PASSWORD=
# Bearer token for the WAZUH-UTILS sidecar (Sysmon config/script publishing).
# Treat like a domain admin credential: its scripts run as SYSTEM on Windows agents.
WAZUH_UTILS_API_KEY=
# Indexer heap: about half the RAM you give it, at most 31g
#INDEXER_JAVA_OPTS=-Xms2g -Xmx2g
# Manager, indexer and dashboard must stay on the same version
#WAZUH_VERSION=4.14.1

###########
# Graylog #
###########
# At least 16 chars; never change after first start (encrypts stored secrets)
GRAYLOG_PASSWORD_SECRET=
# Web UI user "admin"; the SHA-256 hash is derived automatically
GRAYLOG_ROOT_PASSWORD=

###########
# Grafana #
###########
GRAFANA_ADMIN_PASSWORD=

################
# Velociraptor #
################
#VELOX_USER=admin
VELOX_PASSWORD=

###########
# CoPilot #
###########
JWT_SECRET=
SSO_STATE_SECRET=
# Never change once users enrolled 2FA / WAFs are saved
TOTP_ENCRYPTION_KEY=
WAF_TOKEN_ENCRYPTION_KEY=
# Also set as request header "grafana" on CoPilot's Grafana datasource
GRAFANA_API_HEADER_VALUE=
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
#MINIO_ROOT_USER=admin
# At least 8 chars
MINIO_ROOT_PASSWORD=
# Shared by the four CoPilot MCP servers
MCP_AUTH_TOKEN=

# Optional integrations
#OPENAI_API_KEY=
#OPENAI_MODEL=gpt-4o
#VIRUSTOTAL_API_KEY=
# Passkeys need a DNS name (not an IP) served over https; empty disables them
#WEBAUTHN_RP_ID=siem.example.lan
#WEBAUTHN_ORIGINS=https://siem.example.lan:8443

##############
# Host ports #
##############
# Defaults shown. Coolify itself owns 80, 443, 8000, 8080, 6001 and 6002.
#COPILOT_HTTPS_PORT=8443
#COPILOT_PORTAL_PORT=8444
#COPILOT_BACKEND_PORT=5000
#WAZUH_DASHBOARD_PORT=5601
#GRAYLOG_PORT=9000
#GRAFANA_PORT=3000
#VELOCIRAPTOR_FRONTEND_PORT=8100
#VELOCIRAPTOR_GUI_PORT=8889
